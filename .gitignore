# This repository lives beside an installed copy of the game. Ignore every
# root item by default and opt in only the VR project's source material.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/doorstop_config.ini
!/docs/
!/vrmod/

# Keep only source-controlled VR project material below vrmod.
/vrmod/*
!/vrmod/README.md
!/vrmod/CHANGELOG.md
!/vrmod/THIRD_PARTY_NOTICES.txt
!/vrmod/baseline/
!/vrmod/config/
!/vrmod/installer/
!/vrmod/scripts/
!/vrmod/src/
!/vrmod/tests/
!/vrmod/vendor/

# Vendor packages are restored locally and are not committed.
/vrmod/vendor/*
!/vrmod/vendor/README.md

# Build and dependency caches can also appear inside allowed source folders.
**/bin/
**/obj/
**/.vs/
**/.idea/
**/*.user
**/*.suo
